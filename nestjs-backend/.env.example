# Copy file này thành .env rồi điền giá trị thật
PORT=3000

# Database (Aiven MySQL) - NÊN đổi mật khẩu trên Aiven vì mật khẩu cũ đã bị lộ trong code
DB_HOST=your-db-host
DB_PORT=3306
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=QUANLYCHITIEU
DB_SSL=false

# JWT - đổi thành chuỗi ngẫu nhiên dài (vd: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Số request tối đa / phút / IP
RATE_LIMIT_MAX=300

# Các origin frontend được phép gọi API (CORS), phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tài khoản admin được tạo tự động khi khởi động nếu DB chưa có admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smartmoney.vn
ADMIN_PASSWORD=change-me
ADMIN_FULLNAME=Quản Trị Viên
